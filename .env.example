# Copiá este archivo como .env.local y completá los valores (en Vercel, en Settings > Environment Variables).
# Las que empiezan con NEXT_PUBLIC_ llegan al navegador: nunca pongas una clave secreta con ese prefijo.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key de Supabase (saltea RLS). Solo la usa el cron de notificaciones (src/lib/supabase/admin.ts).
SUPABASE_SECRET_KEY=

# Notificaciones push (claves VAPID): npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push, ej. mailto:soporte@tudominio.com
VAPID_SUBJECT=

# Protege /api/cron/* (Vercel lo manda como "Authorization: Bearer ..."). Un texto al azar de 32+ caracteres.
CRON_SECRET=
